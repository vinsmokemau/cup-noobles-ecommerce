{$SITE_ADDRESS} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /admin/* {
		reverse_proxy api:8000
	}

	handle /static/* {
		reverse_proxy api:8000
	}

	# local media (§4.3); unused in production
	handle /media/* {
		reverse_proxy api:8000
	}

	# dev tools (9.10, 10.10); 404 in production
	handle /dev/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
